AGENTD_BASE_URL=http://127.0.0.1:8123
AGENTD_AUTH_TOKEN=REPLACE_WITH_SAME_AGENTD_AUTH_TOKEN
AGENTD_CODEXW_BROKER_URL=https://broker.example
AGENTD_CODEXW_DEPLOYMENT_ID=agentd-linux-1
AGENTD_CODEXW_DISPLAY_NAME=agentd-linux-1
AGENTD_CODEXW_IDENTITY_DIR=/var/lib/agentd/codexw-native
AGENTD_CODEXW_BROKER_USER=admin
AGENTD_CODEXW_BROKER_PASSWORD=REPLACE_WITH_BOOTSTRAP_PASSWORD
# Optional broker bearer token used by readiness self-tests after first-boot
# username/password bootstrap credentials are removed.
AGENTD_CODEXW_BROKER_TOKEN=
# Operator actions stay disabled unless the local daemon owns the safety
# boundary. Set to agentd_ota only after agentd OTA is enabled and its restart
# policy is configured; runtime.restart remains unadvertised.
AGENTD_CODEXW_RUNTIME_UPDATE_MODE=disabled
# Optional first-boot alternative to username/password bootstrap. These are
# consumed once by certificate enrollment and should be removed afterward.
AGENTD_CODEXW_ENROLLMENT_TOKEN_ID=
AGENTD_CODEXW_ENROLLMENT_SECRET=
