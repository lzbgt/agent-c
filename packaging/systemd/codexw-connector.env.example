AGENTD_BASE_URL=http://127.0.0.1:8123
AGENTD_AUTH_TOKEN=REPLACE_WITH_SAME_AGENTD_AUTH_TOKEN
AGENTD_CODEXW_BROKER_URL=https://broker.example
AGENTD_CODEXW_DEPLOYMENT_ID=agentd-linux-1
AGENTD_CODEXW_DISPLAY_NAME=agentd-linux-1
AGENTD_CODEXW_IDENTITY_DIR=/var/lib/agentd/codexw-native
AGENTD_CODEXW_BROKER_USER=admin
AGENTD_CODEXW_BROKER_PASSWORD=REPLACE_WITH_BOOTSTRAP_PASSWORD
# Optional broker bearer token used by readiness self-tests after first-boot
# username/password bootstrap credentials are removed.
AGENTD_CODEXW_BROKER_TOKEN=
AGENTD_CODEXW_SELF_TEST_OUTPUT_PATH=/var/lib/agentd/codexw-native/self-test-status.json
# Runtime status reports connector readiness as stale after this many seconds
# since the last durable self-test. Default is 900 seconds (three timer periods).
AGENTD_CODEXW_SELF_TEST_STALE_AFTER_SECONDS=900
# Operator actions stay disabled unless the local daemon owns the safety
# boundary. Set update mode to agentd_ota only after agentd OTA update/drain is
# enabled and candidate status is available.
AGENTD_CODEXW_RUNTIME_UPDATE_MODE=disabled
# Set to agentd_ota only after /api/v1/ota/status reports restart.enabled=true
# with a systemd/launchd supervisor policy. This advertises runtime.restart.
AGENTD_CODEXW_RUNTIME_RESTART_MODE=disabled
# Set to 1 only when AGENTD_CODEXW_RUNTIME_UPDATE_MODE=agentd_ota and the
# readiness self-test should require broker /actions/preflight to prepare the
# exact status-derived runtime.update payload without dispatching it.
AGENTD_CODEXW_REQUIRE_UPDATE_PREFLIGHT=0
# Optional first-boot alternative to username/password bootstrap. These are
# consumed once by certificate enrollment and should be removed afterward.
AGENTD_CODEXW_ENROLLMENT_TOKEN_ID=
AGENTD_CODEXW_ENROLLMENT_SECRET=
