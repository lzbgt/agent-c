{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Run Event Payload assistant_delta v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["delta"],
  "properties": {
    "delta": {
      "type": "string",
      "description": "Assistant text delta."
    },
    "step": {
      "type": "integer",
      "minimum": 0,
      "description": "Tool-loop step index (optional)."
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "description": "Streaming epoch index (optional)."
    }
  }
}
