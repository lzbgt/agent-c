{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Edge Workflow Event Payload step_state v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "workflow_id",
    "step_id",
    "state"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "description": "Workflow identifier."
    },
    "step_id": {
      "type": "string",
      "description": "Workflow step identifier."
    },
    "state": {
      "type": "string",
      "description": "Step state."
    },
    "idempotency_key": {
      "type": "string",
      "description": "Idempotency key when present."
    },
    "error": {
      "type": "string",
      "description": "Error when present."
    },
    "_ignored_by_platform": {
      "type": "boolean",
      "description": "True when platform ignored the update."
    }
  }
}
