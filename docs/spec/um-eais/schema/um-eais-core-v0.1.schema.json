{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UM‑EAIS Core Message Types v0.1",
  "type": "object",
  "additionalProperties": true,
  "allOf": [
    { "$ref": "umbmp-envelope-v0.1.schema.json" },
    {
      "oneOf": [
        {
          "title": "NODE_HELLO (node → platform)",
          "properties": {
            "type": { "const": "NODE_HELLO" },
            "body": {
              "type": "object",
              "additionalProperties": true,
              "required": ["node_id"],
              "properties": {
                "node_id": { "$ref": "#/$defs/id_token" },
                "model": { "type": "string" },
                "fw_git_sha": { "type": "string" },
                "caps_sha256": { "type": "string" }
              }
            }
          }
        },
        {
          "title": "NODE_HEARTBEAT (node → platform)",
          "properties": {
            "type": { "const": "NODE_HEARTBEAT" },
            "body": {
              "type": "object",
              "additionalProperties": true,
              "required": ["node_id"],
              "properties": {
                "node_id": { "$ref": "#/$defs/id_token" },
                "health": { "type": "object", "additionalProperties": true },
                "caps_sha256": { "type": "string" },
                "battery_pct": { "type": "number" },
                "rssi": { "type": "number" }
              }
            }
          }
        },
        {
          "title": "PLATFORM_CAPS_REQ (platform → node)",
          "properties": {
            "type": { "const": "PLATFORM_CAPS_REQ" },
            "body": {
              "type": "object",
              "additionalProperties": true,
              "required": ["node_id", "want"],
              "properties": {
                "node_id": { "$ref": "#/$defs/id_token" },
                "want": { "enum": ["full", "hash"] }
              }
            }
          }
        },
        {
          "title": "NODE_CAPS_RSP (node → platform)",
          "properties": {
            "type": { "const": "NODE_CAPS_RSP" },
            "body": {
              "type": "object",
              "additionalProperties": true,
              "required": ["node_id", "manifest"],
              "properties": {
                "node_id": { "$ref": "#/$defs/id_token" },
                "manifest": { "type": "object", "additionalProperties": true }
              }
            }
          }
        },
        {
          "title": "TASK_ASSIGN (platform → node)",
          "properties": {
            "type": { "const": "TASK_ASSIGN" },
            "body": {
              "type": "object",
              "additionalProperties": true,
              "required": ["task_id", "step_id", "idempotency_key", "mode", "deadline_utc_ms", "payload"],
              "properties": {
                "task_id": { "$ref": "#/$defs/id_token" },
                "step_id": { "$ref": "#/$defs/id_token" },
                "idempotency_key": { "$ref": "#/$defs/id_token" },
                "mode": { "enum": ["invoke", "agent"] },
                "deadline_utc_ms": { "type": "integer" },
                "attempt": { "type": "integer", "minimum": 0 },
                "payload": { "type": "object", "additionalProperties": true }
              }
            }
          }
        },
        {
          "title": "TASK_ACK (node → platform)",
          "properties": {
            "type": { "const": "TASK_ACK" },
            "body": {
              "type": "object",
              "additionalProperties": true,
              "required": ["task_id", "step_id", "accepted"],
              "properties": {
                "task_id": { "$ref": "#/$defs/id_token" },
                "step_id": { "$ref": "#/$defs/id_token" },
                "idempotency_key": { "$ref": "#/$defs/id_token" },
                "accepted": { "type": "boolean" },
                "reason": { "type": "string" }
              }
            }
          }
        },
        {
          "title": "TASK_EVENT (node → platform)",
          "properties": {
            "type": { "const": "TASK_EVENT" },
            "body": {
              "type": "object",
              "additionalProperties": true,
              "required": ["task_id", "step_id", "state"],
              "properties": {
                "task_id": { "$ref": "#/$defs/id_token" },
                "step_id": { "$ref": "#/$defs/id_token" },
                "idempotency_key": { "$ref": "#/$defs/id_token" },
                "state": { "type": "string" },
                "progress": { "type": "number" },
                "result": {},
                "error": { "type": "string" }
              }
            }
          }
        },
        {
          "title": "TASK_DONE (node → platform)",
          "properties": {
            "type": { "const": "TASK_DONE" },
            "body": {
              "type": "object",
              "additionalProperties": true,
              "required": ["task_id", "step_id", "result"],
              "properties": {
                "task_id": { "$ref": "#/$defs/id_token" },
                "step_id": { "$ref": "#/$defs/id_token" },
                "idempotency_key": { "$ref": "#/$defs/id_token" },
                "result": {}
              }
            }
          }
        },
        {
          "title": "TASK_FAILED (node → platform)",
          "properties": {
            "type": { "const": "TASK_FAILED" },
            "body": {
              "type": "object",
              "additionalProperties": true,
              "required": ["task_id", "step_id", "error"],
              "properties": {
                "task_id": { "$ref": "#/$defs/id_token" },
                "step_id": { "$ref": "#/$defs/id_token" },
                "idempotency_key": { "$ref": "#/$defs/id_token" },
                "error": { "type": "string" }
              }
            }
          }
        },
        {
          "title": "SENSOR_EVENT (node → platform)",
          "properties": {
            "type": { "const": "SENSOR_EVENT" },
            "body": {
              "type": "object",
              "additionalProperties": true,
              "required": ["node_id", "event_type", "ts_utc_ms", "data"],
              "properties": {
                "node_id": { "$ref": "#/$defs/id_token" },
                "event_type": { "type": "string" },
                "ts_utc_ms": { "type": "integer" },
                "confidence": { "type": "number" },
                "data": { "type": "object", "additionalProperties": true }
              }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "id_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    }
  }
}
