{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UM‑EAIS Platform Extensions (Agent Repo Additions) v0.1",
  "type": "object",
  "additionalProperties": true,
  "allOf": [
    { "$ref": "umbmp-envelope-v0.1.schema.json" },
    {
      "oneOf": [
        {
          "title": "WORKFLOW_SUBMIT (node → platform)",
          "properties": {
            "type": { "const": "WORKFLOW_SUBMIT" },
            "body": {
              "type": "object",
              "additionalProperties": true,
              "oneOf": [
                {
                  "required": ["workflow"],
                  "properties": {
                    "workflow": { "$ref": "#/$defs/edge_workflow" }
                  }
                },
                { "$ref": "#/$defs/edge_workflow" }
              ]
            }
          }
        },
        {
          "title": "WORKFLOW_CANCEL (node → platform)",
          "properties": {
            "type": { "const": "WORKFLOW_CANCEL" },
            "body": {
              "type": "object",
              "additionalProperties": true,
              "required": ["workflow_id"],
              "properties": {
                "workflow_id": { "$ref": "#/$defs/id_token" }
              }
            }
          }
        },
        {
          "title": "WORKFLOW_ACK (platform → node)",
          "properties": {
            "type": { "const": "WORKFLOW_ACK" },
            "body": {
              "type": "object",
              "additionalProperties": true,
              "required": ["workflow_id", "ok"],
              "properties": {
                "workflow_id": { "$ref": "#/$defs/id_token" },
                "ok": { "type": "boolean" },
                "status": { "type": "string" }
              }
            }
          }
        },
        {
          "title": "DURABLE_WORKFLOW_SUBMIT (node → platform)",
          "properties": {
            "type": { "const": "DURABLE_WORKFLOW_SUBMIT" },
            "body": {
              "type": "object",
              "additionalProperties": true,
              "oneOf": [
                {
                  "required": ["workflow"],
                  "properties": {
                    "workflow": { "$ref": "#/$defs/durable_workflow_submit" }
                  }
                },
                { "$ref": "#/$defs/durable_workflow_submit" }
              ]
            }
          }
        },
        {
          "title": "DURABLE_WORKFLOW_CANCEL (node → platform)",
          "properties": {
            "type": { "const": "DURABLE_WORKFLOW_CANCEL" },
            "body": {
              "type": "object",
              "additionalProperties": true,
              "required": ["workflow_id"],
              "properties": {
                "workflow_id": { "$ref": "#/$defs/id_token" }
              }
            }
          }
        },
        {
          "title": "DURABLE_WORKFLOW_ACK (platform → node)",
          "properties": {
            "type": { "const": "DURABLE_WORKFLOW_ACK" },
            "body": {
              "type": "object",
              "additionalProperties": true,
              "required": ["workflow_id", "ok", "op"],
              "properties": {
                "workflow_id": { "$ref": "#/$defs/id_token" },
                "ok": { "type": "boolean" },
                "op": { "enum": ["submit", "cancel"] }
              }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "id_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "edge_workflow": {
      "type": "object",
      "additionalProperties": true,
      "required": ["workflow_id", "steps"],
      "properties": {
        "workflow_id": { "$ref": "#/$defs/id_token" },
        "goal": { "type": "string" },
        "priority": { "type": "integer" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["step_id", "kind", "depends_on"],
            "properties": {
              "step_id": { "$ref": "#/$defs/id_token" },
              "kind": { "enum": ["invoke_tool", "run_agent", "join"] },
              "depends_on": {
                "type": "array",
                "items": { "$ref": "#/$defs/id_token" }
              },
              "target": { "type": "object", "additionalProperties": true },
              "payload": { "type": "object", "additionalProperties": true },
              "join_mode": { "enum": ["all", "any"] },
              "deadline_utc_ms": { "type": "integer" },
              "max_attempts": { "type": "integer", "minimum": 1 },
              "backoff_ms": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "durable_workflow_submit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tasks"],
      "properties": {
        "workflow_id": { "$ref": "#/$defs/id_token" },
        "trace_id": { "$ref": "#/$defs/id_token" },
        "idempotency_key": { "$ref": "#/$defs/id_token" },
        "allow_inline_api_keys": { "type": "boolean" },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    }
  }
}

