{
  "sop": {
    "schema": "agentd.sop.v1",
    "id": "inspection",
    "version": "1",
    "title": "Inspection process",
    "stages": [
      {
        "id": "intake",
        "actions": [
          {
            "task_id": "register",
            "kind": "delay",
            "delay_ms": 0
          }
        ]
      },
      {
        "id": "checks",
        "mode": "parallel",
        "actions": [
          {
            "task_id": "quality",
            "kind": "delay",
            "delay_ms": 0
          },
          {
            "task_id": "inventory",
            "kind": "delay",
            "delay_ms": 0
          }
        ]
      },
      {
        "id": "release",
        "actions": [
          {
            "task_id": "record",
            "kind": "delay",
            "delay_ms": 0
          }
        ]
      }
    ]
  }
}
