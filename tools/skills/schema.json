{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repo Skill Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill", "version", "description"],
  "properties": {
    "skill": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "adds": {"type": "array", "items": {"type": "string"}, "default": []},
    "modifies": {"type": "array", "items": {"type": "string"}, "default": []},
    "patches": {"type": "array", "items": {"type": "string"}, "default": []},
    "apply": {"type": "string"},
    "post_apply": {"type": "array", "items": {"type": "string"}, "default": []}
  }
}
