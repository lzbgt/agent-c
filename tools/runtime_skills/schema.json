{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime Skill Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_id", "version", "description", "kind"],
  "properties": {
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "instruction_pack",
        "workflow_bundle",
        "team_bundle",
        "policy_bundle"
      ]
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "plugins": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "features": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "inputs_schema": {
      "type": "object"
    },
    "instruction_fragments": {
      "type": "object"
    },
    "workflow_template": {
      "type": "object"
    },
    "team_template": {
      "type": "object"
    },
    "policy_preset": {
      "type": "object"
    },
    "ui": {
      "type": "object"
    }
  }
}
