{
  "name": "agentd_smoke",
  "steps": [
    {
      "type": "http",
      "name": "agentd_health",
      "url": "http://127.0.0.1:{{env.AGENTD_PUBLISHED_PORT}}/api/v1/health",
      "expect_status": 200
    },
    {
      "type": "http",
      "name": "agentd_diagnostics",
      "url": "http://127.0.0.1:{{env.AGENTD_PUBLISHED_PORT}}/api/v1/diagnostics",
      "expect_status": 200
    },
    {
      "type": "capture_evidence",
      "name": "evidence",
      "args": ["--agentd-base", "http://127.0.0.1:{{env.AGENTD_PUBLISHED_PORT}}"]
    }
  ]
}
