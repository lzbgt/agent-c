{
  "name": "agentd_smoke",
  "steps": [
    {
      "type": "http",
      "name": "agentd_health",
      "url": "{{env.AGENTD_BASE}}/api/v1/health",
      "expect_status": 200
    },
    {
      "type": "http",
      "name": "agentd_diagnostics",
      "url": "{{env.AGENTD_BASE}}/api/v1/diagnostics",
      "headers": {
        "Authorization": "Bearer {{env.AGENTD_AUTH_TOKEN}}"
      },
      "expect_status": 200
    },
    {
      "type": "capture_evidence",
      "name": "evidence",
      "args": [
        "--agentd-base", "{{env.AGENTD_BASE}}",
        "--agentd-token", "{{env.AGENTD_AUTH_TOKEN}}"
      ]
    }
  ]
}
