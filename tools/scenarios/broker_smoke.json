{
  "name": "broker_smoke",
  "steps": [
    {
      "type": "http",
      "name": "broker_healthz",
      "url": "https://127.0.0.1:{{env.BROKER_PUBLISHED_PORT}}/healthz",
      "insecure": true,
      "expect_status": 200
    },
    {
      "type": "http",
      "name": "broker_readyz",
      "url": "https://127.0.0.1:{{env.BROKER_PUBLISHED_PORT}}/readyz",
      "insecure": true,
      "expect_status": 200
    },
    {
      "type": "capture_evidence",
      "name": "evidence",
      "args": [
        "--agentd-base", "http://127.0.0.1:{{env.AGENTD_PUBLISHED_PORT}}",
        "--broker-base", "https://127.0.0.1:{{env.BROKER_PUBLISHED_PORT}}",
        "--broker-agent-id", "agent1",
        "--agentd-via-broker"
      ]
    }
  ]
}
