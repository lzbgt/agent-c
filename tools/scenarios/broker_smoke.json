{
  "name": "broker_smoke",
  "steps": [
    {
      "type": "http",
      "name": "broker_healthz",
      "url": "{{env.BROKER_BASE}}/healthz",
      "insecure": true,
      "expect_status": 200
    },
    {
      "type": "http",
      "name": "broker_readyz",
      "url": "{{env.BROKER_BASE}}/readyz",
      "insecure": true,
      "expect_status": 200
    },
    {
      "type": "capture_evidence",
      "name": "evidence",
      "args": [
        "--agentd-base", "{{env.AGENTD_BASE}}",
        "--agentd-token", "{{env.AGENTD_AUTH_TOKEN}}",
        "--broker-base", "{{env.BROKER_BASE}}",
        "--broker-agent-id", "agent1",
        "--agentd-via-broker"
      ]
    }
  ]
}
